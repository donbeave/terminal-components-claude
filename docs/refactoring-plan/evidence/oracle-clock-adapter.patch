+        crate::oracle_clock::set_millis(0);
+        let mut page = FormsPage::new();
+        page.state = Submit::Busy(crate::oracle_clock::Instant::now());
+        page.submit.busy = true;
+        let mut focus = junie_tui::core::focus::Focus::default();
+        let ring = junie_tui::core::focus::FocusRing::default();
+        let mut cx = PageCtx { focus: &mut focus, ring: &ring, requests: vec![] };
+        for ms in [1799,1800] {
+            crate::oracle_clock::set_millis(ms);
+            page.handle(&PageEvent::Tick, &mut cx);
+            assert!(matches!(page.state, Submit::Busy(_)));
+        }
+        crate::oracle_clock::set_millis(1801);
+        page.handle(&PageEvent::Tick, &mut cx);
+        assert_eq!(page.state, Submit::Done);
+        assert!(!page.submit.busy);
+    }
+}
