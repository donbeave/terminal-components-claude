{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "terminal-components/campaign-ledger/v1",
  "title": "Campaign ledger",
  "description": "Operator-maintained resumable state. It is not candidate authority; preflight accepts only fully bound receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "integration_ref", "integration_head", "armed", "catalog", "toolchain", "tasks", "receipts"],
  "properties": {
    "schema": {"const": "campaign-ledger/v1"},
    "integration_ref": {"type": "string", "pattern": "^refs/heads/.+$"},
    "integration_head": {"$ref": "#/$defs/fullSha", "description": "Exact current tip; preflight compares it with the live branch tip."},
    "armed": {"type": "boolean", "description": "Preflight requires false; this field cannot authorize work by itself."},
    "armed_at": {"$ref": "#/$defs/timestamp"},
    "catalog": {"$ref": "#/$defs/catalog"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "preparation": {"$ref": "#/$defs/preparationQualification"},
    "receipts": {
      "type": "object",
      "patternProperties": {
        "^task-[0-9]{3}$": {"oneOf": [{"$ref": "#/$defs/receipt"}, {"$ref": "#/$defs/legacyReceipt"}]}
      },
      "additionalProperties": false
    },
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}, "uniqueItems": true},
    "notes": {"type": "string"}
  },
  "$defs": {
    "fullSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "taskId": {"type": "string", "pattern": "^TASK-[0-9]{3}$"},
    "receiptKey": {"type": "string", "pattern": "^task-[0-9]{3}$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "absolutePath": {"type": "string", "pattern": "^/[^\u0000]*$"},
    "relativePath": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "dependencyList": {"type": "array", "items": {"$ref": "#/$defs/taskId"}, "uniqueItems": true},
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "branch", "manifest", "recorded_at"],
      "properties": {
        "commit": {"$ref": "#/$defs/fullSha"},
        "tree": {"$ref": "#/$defs/fullSha"},
        "branch": {"type": "string", "minLength": 1},
        "manifest": {"$ref": "#/$defs/manifestReference"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskfmt_revision", "taskfmt_version", "taskfmt_sha256", "taskfmt_source", "taskfmt_path"],
      "properties": {
        "architectural_main": {"$ref": "#/$defs/fullSha"},
        "oracle_commit": {"$ref": "#/$defs/fullSha"},
        "visual_baseline_tag_peeled": {"$ref": "#/$defs/fullSha"},
        "taskfmt_revision": {"$ref": "#/$defs/fullSha"},
        "taskfmt_version": {"type": "string", "minLength": 1},
        "taskfmt_sha256": {"$ref": "#/$defs/sha256"},
        "taskfmt_source": {"$ref": "#/$defs/absolutePath"},
        "taskfmt_path": {"$ref": "#/$defs/absolutePath"},
        "tuisnap_path": {"anyOf": [{"const": ""}, {"$ref": "#/$defs/absolutePath"}]}
      }
    },
    "pathReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifestIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree", "manifest"],
      "properties": {
        "commit": {"$ref": "#/$defs/fullSha"},
        "tree": {"$ref": "#/$defs/fullSha"},
        "manifest": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {"$ref": "#/$defs/relativePath"},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        }
      }
    },
    "manifestReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "qualificationArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "path", "sha256"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^CHK-[0-9]{3}$"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "preparationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "run_id", "preparation_receipt", "context_index", "observer", "contexts", "results"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "preparation_receipt": {"$ref": "#/$defs/pathReference"},
        "context_index": {"$ref": "#/$defs/pathReference"},
        "observer": {"$ref": "#/$defs/pathReference"},
        "contexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualificationArtifact"}},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/qualificationArtifact"}}
      }
    },
    "preparationDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_id", "evidence", "verdict", "recorded_at"],
      "properties": {
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "evidence": {"$ref": "#/$defs/pathReference"},
        "verdict": {"const": "VERIFIED"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "preparationFreshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualified_at", "expires_at", "max_age_seconds"],
      "properties": {
        "qualified_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "max_age_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "preparationQualification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "integration_ref", "candidate_commit", "candidate_tree", "oracle", "catalog", "task_graph", "taskfmt", "proof_preparation", "verifier", "reviewer", "freshness"],
      "properties": {
        "schema": {"const": "campaign-preparation-qualification/v1"},
        "integration_ref": {"type": "string", "pattern": "^refs/heads/.+$"},
        "candidate_commit": {"$ref": "#/$defs/fullSha"},
        "candidate_tree": {"$ref": "#/$defs/fullSha"},
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tag", "commit", "tree"],
          "properties": {
            "tag": {"type": "string", "minLength": 1},
            "commit": {"$ref": "#/$defs/fullSha"},
            "tree": {"$ref": "#/$defs/fullSha"}
          }
        },
        "catalog": {"$ref": "#/$defs/manifestIdentity"},
        "task_graph": {"$ref": "#/$defs/manifestIdentity"},
        "taskfmt": {
          "type": "object",
          "additionalProperties": false,
          "required": ["taskfmt_revision", "taskfmt_version", "taskfmt_sha256", "taskfmt_source", "taskfmt_path"],
          "properties": {
            "taskfmt_revision": {"$ref": "#/$defs/fullSha"},
            "taskfmt_version": {"type": "string", "minLength": 1},
            "taskfmt_sha256": {"$ref": "#/$defs/sha256"},
            "taskfmt_source": {"$ref": "#/$defs/absolutePath"},
            "taskfmt_path": {"$ref": "#/$defs/absolutePath"}
          }
        },
        "proof_preparation": {"$ref": "#/$defs/preparationProof"},
        "verifier": {"$ref": "#/$defs/preparationDecision"},
        "reviewer": {"$ref": "#/$defs/preparationDecision"},
        "freshness": {"$ref": "#/$defs/preparationFreshness"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "status"],
      "properties": {
        "task_id": {"$ref": "#/$defs/taskId"},
        "status": {"enum": ["pending", "dispatched", "verified", "integrated", "blocked"]},
        "parent_sha": {"$ref": "#/$defs/fullSha"},
        "candidate_tree_sha": {"$ref": "#/$defs/fullSha"},
        "verifier_verdict": {"enum": ["VERIFIED", "REJECTED", "BLOCKED", "NOT_RUN"]},
        "reviewer_verdict": {"enum": ["VERIFIED", "REJECTED", "BLOCKED", "NOT_RUN"]},
        "receipt_key": {"$ref": "#/$defs/receiptKey"},
        "dependencies": {"$ref": "#/$defs/dependencyList"},
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "integrated_at": {"$ref": "#/$defs/timestamp"},
        "notes": {"type": "string"},
        "driver_evidence": {"type": "string", "minLength": 1},
        "verify_evidence": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["verified", "integrated"]}}, "required": ["status"]},
          "then": {"required": ["parent_sha", "candidate_tree_sha", "verifier_verdict", "reviewer_verdict", "receipt_key", "dependencies", "run_id"]}
        },
        {
          "if": {"properties": {"status": {"const": "integrated"}}, "required": ["status"]},
          "then": {"required": ["integrated_at"]}
        }
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "task_id", "base", "candidate_tree_sha", "integration_commit", "run_id", "exit", "last_line", "status", "path", "sha256", "recorded_at"],
      "properties": {
        "schema": {"const": "campaign-task-result/v1"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "base": {"$ref": "#/$defs/fullSha"},
        "candidate_tree_sha": {"$ref": "#/$defs/fullSha"},
        "integration_commit": {"$ref": "#/$defs/fullSha"},
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "exit": {"const": 0},
        "last_line": {"const": "DONE"},
        "status": {"const": "passed"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "task_id", "base", "candidate_tree_sha", "integration_commit", "run_id", "verdict", "evidence", "evidence_sha256", "result_sha256", "recorded_at"],
      "properties": {
        "schema": {"const": "campaign-review/v1"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "base": {"$ref": "#/$defs/fullSha"},
        "candidate_tree_sha": {"$ref": "#/$defs/fullSha"},
        "integration_commit": {"$ref": "#/$defs/fullSha"},
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "verdict": {"enum": ["VERIFIED", "REJECTED", "BLOCKED", "NOT_RUN"]},
        "evidence": {"$ref": "#/$defs/absolutePath"},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "result_sha256": {"$ref": "#/$defs/sha256"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "task_id", "product", "dependencies", "base", "candidate_tree_sha", "integration_commit", "run_id", "receipt_sha256", "evidence", "result", "reviewer", "recorded_at"],
      "properties": {
        "schema": {"const": "campaign-receipt/v2"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "product": {"type": "string", "minLength": 1},
        "dependencies": {"$ref": "#/$defs/dependencyList"},
        "base": {"$ref": "#/$defs/fullSha"},
        "candidate_tree_sha": {"$ref": "#/$defs/fullSha"},
        "integration_commit": {"$ref": "#/$defs/fullSha"},
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "receipt_sha256": {"$ref": "#/$defs/sha256", "description": "SHA-256 of the immutable verifier evidence file."},
        "evidence": {"$ref": "#/$defs/relativePath"},
        "result": {"$ref": "#/$defs/result"},
        "reviewer": {"$ref": "#/$defs/reviewer"},
        "verify_exit": {"const": 0},
        "verify_last_line": {"const": "DONE"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}
      }
    },
    "legacyReceipt": {
      "type": "object",
      "required": ["product", "recorded_at"],
      "not": {"required": ["schema"]},
      "properties": {
        "product": {"type": "string"},
        "receipt_sha256": {"$ref": "#/$defs/sha256"},
        "base": {"$ref": "#/$defs/fullSha"},
        "integration_commit": {"$ref": "#/$defs/fullSha"},
        "verify_exit": {"type": "integer"},
        "verify_last_line": {"type": "string"},
        "evidence": {"type": "string"},
        "recorded_at": {"$ref": "#/$defs/timestamp"}
      },
      "additionalProperties": true
    },
    "proofPreparation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "task_id", "worktree", "commit", "scope_base", "run_id", "native_build", "taskfmt", "context_index", "contexts", "results", "observer"],
      "properties": {
        "schema": {"const": "campaign-proof-preparation/v1"},
        "task_id": {"$ref": "#/$defs/taskId"},
        "worktree": {"$ref": "#/$defs/absolutePath"},
        "commit": {"$ref": "#/$defs/fullSha"},
        "scope_base": {"$ref": "#/$defs/fullSha"},
        "run_id": {"$ref": "#/$defs/absolutePath"},
        "native_build": {
          "type": "object",
          "additionalProperties": false,
          "required": ["receipt", "receipt_sha256", "binary", "binary_sha256"],
          "properties": {
            "receipt": {"$ref": "#/$defs/absolutePath"},
            "receipt_sha256": {"$ref": "#/$defs/sha256"},
            "binary": {"$ref": "#/$defs/absolutePath"},
            "binary_sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        "taskfmt": {"$ref": "#/$defs/toolchain"},
        "context_index": {"$ref": "#/$defs/indexReference"},
        "contexts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactReference"}},
        "results": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifactReference"}},
        "observer": {"$ref": "#/$defs/indexReference"}
      }
    },
    "artifactReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "path", "sha256"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^CHK-[0-9]{3}$"},
        "path": {"$ref": "#/$defs/absolutePath"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "indexReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"$ref": "#/$defs/absolutePath"}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
