/target
baseline/**/*.png
baseline/**/*.html
tools/**/__pycache__/
shots/.capture-state/
# The matrix lock and its crash-recovery staging directories are generated
# before capture provenance snapshots Git state; neither is evidence.
shots/.capture-matrix.lock*
.DS_Store

# trybuild writes candidate .stderr files here when a case has none yet
crates/tui/wip/

# local capture/analysis scratch trees
.codex-target-*/
.mbx-target-*/

# untracked parity capture artifacts
parity/

# local taskfmt qualification sandbox (not operator evidence)
.qual/

# local git worktrees (nested checkouts; not part of the branch tree)
.worktrees/

# campaign operator runtime (ledger, runs, evidence) — not committed
.campaign/ledger.json
.campaign/runs/
.campaign/evidence/
.campaign/host/

# local snapshot scratch (committed oracle store lives under shots/)
snapshots/
snapshots.actual

# sync-binaries.sh overwrites committed shell wrappers with Mach-O copies for
# qualification; do not commit those synced artifacts (restore wrappers before push)
tools/refactor-proof/bin/tc-proof
tools/refactor-proof/bin/tc-proof-host
